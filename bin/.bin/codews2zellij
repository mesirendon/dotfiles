#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "Usage: codews2zellij <file.code-workspace> [--cmd 'nvim .']"
	exit 1
fi

WS_FILE="$1"
RUN_CMD="${2:-}"
[[ -f "$WS_FILE" ]] || {
	echo "File not found: $WS_FILE"
	exit 1
}

# Convert JSONC to valid JSON
JSON="$(perl -0777 -pe '
  s{/\*.*?\*/}{}gs;
  s{//[^\n\r]*}{}g;
  s/,\s*([}\]])/\1/g;
' "$WS_FILE")"

# Base directory of workspace
WS_DIR="$(cd "$(dirname "$WS_FILE")" && pwd)"

# Extract folders
mapfile -t FOLDERS < <(jq -c '.folders[]?' <<<"$JSON")
[[ ${#FOLDERS[@]} -eq 0 ]] && {
	echo "No folders found in workspace"
	exit 1
}

for fjson in "${FOLDERS[@]}"; do
	PATH_VAL="$(jq -r '.path // empty' <<<"$fjson")"
	[[ -z "$PATH_VAL" ]] && continue

	# Resolve relative paths
	case "$PATH_VAL" in
	~/*) ABS_DIR="${PATH_VAL/#\~/$HOME}" ;;
	/*) ABS_DIR="$PATH_VAL" ;;
	*) ABS_DIR="$WS_DIR/$PATH_VAL" ;;
	esac
	ABS_DIR="$(cd "$ABS_DIR" 2>/dev/null && pwd || echo "")"
	[[ -z "$ABS_DIR" || ! -d "$ABS_DIR" ]] && {
		echo "Skipping missing folder: $PATH_VAL"
		continue
	}

	WIN_NAME="$(jq -r '.name // .label // empty' <<<"$fjson")"
	[[ -z "$WIN_NAME" ]] && WIN_NAME="$(basename "$ABS_DIR")"

	FOLDER_CMD="$(jq -r '."x-zellij-cmd" // empty' <<<"$fjson")"
	SKIP="$(jq -r '."x-zellij-skip" // false' <<<"$fjson")"
	[[ "$SKIP" == "true" ]] && {
		echo "Skipping $WIN_NAME"
		continue
	}

	echo "Opening tab '$WIN_NAME' in $ABS_DIR"
	zellij action new-tab --name "$WIN_NAME" --cwd "$ABS_DIR"
	sleep 0.05
	CMD="${FOLDER_CMD:-$RUN_CMD}"
	if [[ -n "$CMD" ]]; then
		zellij action write-chars "$CMD"$'\n'
	fi
done
